#!/bin/bash /etc/ikcommon

Include interface.sh, iptables.sh, sys/cgroup_control.sh
I18nload rc.json

boot_load_sync()
{
	if [ "$DEVELOPER" ];then
		$IK_DIR_SCRIPT/$1 boot $2 >/tmp/iktmp/bootlog/${1//\//.} 2>&1
	else
		$IK_DIR_SCRIPT/$1 boot $2 >/dev/null 2>&1
	fi
}

boot_load_async()
{
	if [ "$DEVELOPER" ];then
		$IK_DIR_SCRIPT/$1 boot $2 >/tmp/iktmp/bootlog/${1//\//.} 2>&1 &
	else
		$IK_DIR_SCRIPT/$1 boot $2 >/dev/null 2>&1 &
	fi
}

start_remote_services()
{
	[ "$(cat /etc/mnt/ikuai/ctpanel_cloud_remote.conf 2>/dev/null)" != "RCSTATUS=on" ] && return 0
	mkdir -p /tmp/ik_lua_files
	ln -sf /etc/http_lua/ik_lua.data /tmp/ik_lua_files
	ik_rc_client
	pmd
	if [ "$OEMNAME" = "zh" ];then
		ln -sf /usr/ikuai/script/cre_client.sh /usr/bin/cre_client
		cre_client start >/dev/null 2>&1 &
	fi
}

start_ikuai_services()
{
    # Embedded credentials must never be readable by unprivileged processes.
    for key in /etc/remote2/ca-certificates.d/ikuai/client.key /etc/ssl/32015/ca.key /etc/ssl/32016/ca.key /etc/ssl/32017/ca.key /etc/ssl/mtls/client.key /etc/swanctl/ikca/rootCA.key /usr/ikuai/ctrlclient/priv.key /usr/openresty/ssl/server.key; do
        [ ! -f "$key" ] || chmod 600 "$key"
    done
	iktimerd
	iksyslogd
	ikstats
	openresty
	if ! [ "$(cat /etc/mnt/ikuai/ctpanel_cloud_remote.conf 2>/dev/null)" != "RCSTATUS=on" ]; then
		cre >/dev/null 2>&1 &
	fi
	ik_kernel_event >/dev/null 2>&1 &
	ik_black >/dev/null 2>&1 &
	ik_host_ua >/dev/null 2>&1 &
	ik_stats_collect -ds /proc/ikuai/stats/ik_proto_stats >/dev/null 2>&1 &
}

lcd_init()
{
	if [ "$SUPPORT_LCD" ]; then
		boot_load_async  lcd.sh
	fi
}

c90_modem_init()
{
	/usr/ikuai/script/utils/modem_power restart
}

c90_modem_wait()
{
	local count=1
	while true; do
		sleep 3
		if [ -e "/dev/ttyUSB2" -a -e "/sys/class/net/usb0" ]; then
			break
		fi
		count=$((count+1))
		if [ "$count" -gt "15" ]; then
			break
		fi
	done

}

lte_module_init()
{
	[ "$ENTERPRISE" -o "$SUPPORT_LTE" ] || return

	#5G 通信网卡
	if [ "$MODELTYPE" = "C90" -o "$MODELTYPE" = "C3000" ]; then
		c90_modem_init
	fi

	if [ -e "/lib/modules/$LINUX_VERSION/usbserial.ko" ]; then
		insmod /lib/modules/$LINUX_VERSION/usbserial.ko >/dev/null 2>&1
		insmod /lib/modules/$LINUX_VERSION/usb_wwan.ko >/dev/null 2>&1
		insmod /lib/modules/$LINUX_VERSION/option.ko >/dev/null 2>&1
	fi

	if [ "$MODELTYPE" = "C90" -o "$MODELTYPE" = "C3000" ]; then
		c90_modem_wait
		if [ -e "/sys/class/net/modem" ]; then
			local if_macaddr=$(cat /sys/class/net/modem/address)
			local if_desc="5G Wireless Cardbus Adapter"
			local if_driver="lte"
			local INTERFACE="modem"
			ip link set $INTERFACE up
			echo "$INTERFACE $if_macaddr $if_driver $if_desc" >> /tmp/iktmp/cache/ether_info
		fi
	fi
	if [ -e "/dev/ttyUSB2" ]; then

		#c3000 need disable
		if [ "$MODELTYPE" != "C3000" ]; then
			#支持4G卡插拔
			echo -e "at+qsimdet=1,0\r\n" | microcom -s 115200 -t 50 /dev/ttyUSB2
			echo -e "at+qsimstat=1\r\n" | microcom -s 115200 -t 50 /dev/ttyUSB2
		fi

		#配置网卡模式 （0 Rmnet、1 ECM、2 MBIM、3 RNIDS
		echo -e "at+qcfg=\"usbnet\",1\r\n" | microcom -s 115200 -t 300 /dev/ttyUSB2
		sleep 1	
		ifconfig usb0 down ;ifconfig usb0 up	
		ifconfig usb0 down ;ifconfig usb0 up

		if [ "$MODELTYPE" = "C90" ]; then
			#detect sim
			echo "in" > /sys/class/gpio/sim_det_pin/direction
			local is_sim_inserted=`cat /sys/class/gpio/sim_det_pin/value`
			echo "out" > /sys/class/gpio/sim_det_pin/direction
			echo "1" > /sys/class/gpio/sim_det_pin/value

			echo -e "AT+CFUN=0\r\n" | microcom -s 115200 -t 50 /dev/ttyUSB2

			# have sim and want use it
			if [ x"$is_sim_inserted" == x"1" ]; then
				#use sim
				echo 1 > /sys/class/gpio/sim_sel_pin/value
				echo 0 > /sys/class/gpio/sim_det_pin/value
				sleep 2
				echo 1 > /sys/class/gpio/sim_det_pin/value

				echo -e "AT+QSIMDET=1,1\r\n" | microcom -s 115200 -t 50 /dev/ttyUSB2
			else
				#use esim
				echo 0 > /sys/class/gpio/sim_sel_pin/value
				echo 0 > /sys/class/gpio/sim_det_pin/value
				sleep 2
				echo 1 > /sys/class/gpio/sim_det_pin/value
				echo -e "AT+QSIMDET=1,0\r\n" | microcom -s 115200 -t 50 /dev/ttyUSB2
			fi

			echo -e "AT+CFUN=1,1\r\n" | microcom -s 115200 -t 50 /dev/ttyUSB2
			c90_modem_wait
			echo -e "AT+CFUN=1\r\n" | microcom -s 115200 -t 50 /dev/ttyUSB2

			#lock 5g band to 41,78,79
			echo -e "AT+QNWPREFCFG=\"nr5g_band\",41:78:79\r\n" | microcom -s 115200 -t 300 /dev/ttyUSB2
			ifconfig modem down ;ifconfig modem up
		fi

		#disable sim detect for c3000
		if [ "$MODELTYPE" = "C3000" ]; then
				#flush output
				echo -e "ATI\r\n" | microcom -s 115200 -t 300 /dev/ttyUSB2 >/dev/null 2>&1
				echo -e "ATI\r\n" | microcom -s 115200 -t 300 /dev/ttyUSB2 >/dev/null 2>&1

				local cnt=0
                while [ $cnt -lt 10 ]; do
					local res=$(echo -e "AT+QSIMDET?\r\n" | microcom -s 115200 -t 300 /dev/ttyUSB2| awk '/QSIMDET/{if(NR==3)print $2}')
					if [ -n "$res" ]; then
						break;
					fi
					cnt=`expr $cnt + 1`

					sleep 1
				done

				if echo $res | grep -q '1,'; then
					echo -e "AT+CFUN=0\r\n" | microcom -s 115200 -t 50 /dev/ttyUSB2
					sleep 2
					echo -e "AT+QSIMDET=0,0\r\n" | microcom -s 115200 -t 50 /dev/ttyUSB2
					echo -e "AT+CFUN=1,1\r\n" | microcom -s 115200 -t 50 /dev/ttyUSB2
					c90_modem_wait
					echo -e "AT+CFUN=1\r\n" | microcom -s 115200 -t 50 /dev/ttyUSB2
				fi
		fi

	fi
}

cpufreq_init()
{
	if [ -e "/sys/devices/system/cpu/intel_pstate/no_turbo" ]; then
		if [ -e "/sys/devices/system/cpu/intel_pstate/status" ]; then
			echo "passive" > /sys/devices/system/cpu/intel_pstate/status
		fi
		local no_turbo=$(cat /sys/devices/system/cpu/intel_pstate/no_turbo)
		echo "$no_turbo" > /sys/devices/system/cpu/intel_pstate/no_turbo 2>/dev/null
		## bios 关闭睿频 或者 本身不支持睿频
		if [ "$?" != "0" ]; then
			touch /tmp/iktmp/no_turbo
			if [ -e "/sys/devices/system/cpu/intel_pstate/status" ]; then
				echo "active" > /sys/devices/system/cpu/intel_pstate/status
			fi
		fi
	fi
}

clean_temp_webuser()
{
	sqlite3 $IK_DB_CONFIG "delete from webuser where id == 0; delete from usergroup where id == 0;"
}

# Remove rows containing shell IFS expansion markers before any feature script
# loads configuration from the database.  This is a startup safety net for a
# tampered database; individual feature scripts must still avoid eval.
sanitize_config_db_ifs()
{
	local config_db="$IK_DB_CONFIG"
	local wecom_db="${IK_DB_WECOM:-/etc/mnt/ikuai/wecom.db}"
	local wpa_ppsk_db="${IK_AC_PSK_DB:-/etc/mnt/ikuai/wpa_ppsk.db}"
	local docker_db="${IK_DB_DOCKER:-/etc/mnt/ikuai/docker.db}"
	local max_db_size=$((1 * 1024 * 1024))
	local bad_marker='${IFS}'
	local log_file="$IK_DIR_TMP/bootlog/db_sanitize.log"
	local db db_name db_size line table id deleted delete_output
	local schema_output schema_line cid column rest checked_tables id_tables
	local insert_re_quoted insert_re_plain
	local delete_sql matched_rows deleted_rows skipped_lines

	mkdir -p "${log_file%/*}"
	: > "$log_file"

	insert_re_quoted='^INSERT[[:space:]]+INTO[[:space:]]+"([A-Za-z_][A-Za-z0-9_]*)"[[:space:]]+VALUES\(([0-9]+),'
	insert_re_plain='^INSERT[[:space:]]+INTO[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)[[:space:]]+VALUES\(([0-9]+),'

	for db in "$config_db" "$wecom_db" "$wpa_ppsk_db" "$docker_db"; do
		db_name=${db##*/}
		if [ ! -r "$db" ]; then
			printf 'database=%s skipped=unreadable\n' "$db_name" >> "$log_file"
			continue
		fi

		db_size=$(stat -c %s "$db" 2>/dev/null) || \
			db_size=$(stat -f %z "$db" 2>/dev/null) || {
			printf 'database=%s skipped=stat_failed\n' "$db_name" >> "$log_file"
			continue
		}
		if [ "$db_size" -ge "$max_db_size" ]; then
			printf 'database=%s size=%s skipped=size_limit max_size=%s\n' \
				"$db_name" "$db_size" "$max_db_size" >> "$log_file"
			continue
		fi

		delete_sql="BEGIN IMMEDIATE;"
		matched_rows=0
		deleted_rows=0
		skipped_lines=0
		checked_tables=""
		id_tables=""
		while IFS= read -r line; do
			if [[ "$line" =~ $insert_re_quoted ]]; then
				table=${BASH_REMATCH[1]}
				id=${BASH_REMATCH[2]}
			elif [[ "$line" =~ $insert_re_plain ]]; then
				table=${BASH_REMATCH[1]}
				id=${BASH_REMATCH[2]}
			else
				skipped_lines=$((skipped_lines + 1))
				continue
			fi

			case "|$checked_tables|" in
				*"|$table|"*) ;;
				*)
					checked_tables="${checked_tables:+$checked_tables|}$table"
					schema_output=$(sqlite3 -batch "$db" \
						"PRAGMA table_info(\"$table\");" 2>>"$log_file") || true
					schema_line=${schema_output%%$'\n'*}
					IFS='|' read -r cid column rest <<< "$schema_line"
					[ "$cid" = "0" -a "$column" = "id" ] && \
						id_tables="${id_tables:+$id_tables|}$table"
					;;
			esac
			case "|$id_tables|" in
				*"|$table|"*) ;;
				*)
					skipped_lines=$((skipped_lines + 1))
					continue
					;;
			esac

			delete_sql+=$'\n'"DELETE FROM \"$table\" WHERE id = $id;"
			delete_sql+=$'\n'"SELECT '$table|$id|' || changes();"
			matched_rows=$((matched_rows + 1))
		done < <(nice -n 19 sqlite3 -batch "$db" ".dump" 2>>"$log_file" | \
			LC_ALL=C nice -n 19 grep -F "$bad_marker")

		if [ "$matched_rows" -gt 0 ]; then
			delete_sql+=$'\nCOMMIT;'
			delete_output=$(sqlite3 -batch -bail -cmd ".timeout 5000" "$db" \
				<<< "$delete_sql" 2>>"$log_file") || continue
			while IFS='|' read -r table id deleted; do
				[[ "$deleted" =~ ^[0-9]+$ ]] || continue
				deleted_rows=$((deleted_rows + deleted))
				printf 'database=%s deleted table=%s id=%s rows=%s\n' \
					"$db_name" "$table" "$id" "$deleted" >> "$log_file"
			done <<< "$delete_output"
		fi

		printf 'database=%s size=%s matched_rows=%s deleted_rows=%s skipped_lines=%s marker=%s\n' \
			"$db_name" "$db_size" "$matched_rows" "$deleted_rows" \
			"$skipped_lines" "$bad_marker" >> "$log_file"
	done
	return 0
}

boot_for_apmode()
{
	if [ ! "$CURRENT_APMODE" ] ;then
		rm -rf /usr/ikuai/www/ap_mode
		return
	fi

	load_sysctl			#sysctl -p
	create_temp_file		#初始化TMP目录

	mv /usr/ikuai/www/ap_mode /usr/ikuai
	rm -rf /usr/ikuai/www
	mv /usr/ikuai/ap_mode /usr/ikuai/www
	ln -sf $IK_DIR_SCRIPT/utils/led.sh $IK_DIR_SCRIPT/leds

	ikstats
	lldpd >/dev/null 2>&1
	$IK_DIR_SCRIPT/wifi.sh apinit
	$IK_DIR_SCRIPT/utils/rps.sh boot
	$IK_DIR_SCRIPT/utils/led.sh boot
	$IK_DIR_SCRIPT/apmode/apsysinfo.sh boot
	$IK_DIR_SCRIPT/apmode/apmesh.sh boot
	$IK_DIR_SCRIPT/apmode/wtp.sh init
	$IK_DIR_SCRIPT/apmode/monitor.sh
	echo 3 > /proc/sys/vm/drop_caches

	exit 0
}

boot()
{
	boot_for_apmode

	#系统环境初始化
	load_sysctl			#sysctl -p
	create_temp_file		#初始化TMP目录
	lte_module_init                 #初始化4G模块的相关配置
	restore_factory_default		#出厂配置
	autoconfig_by_udisk		#检查U盘的自动配置
	create_ipset_default		#初始化ipset
	create_iptables_chain		#初始化iptables链
	$IK_DIR_SCRIPT/strict_policy.sh early_guard >/tmp/iktmp/strict-early.log 2>&1
	openresty_config_init		#初始化nginx线程数量
	portal_crt_link_oem		#关联portal证书
	mips_port_init			#初始化mips架构的port状态
	cpufreq_init			#初始化4G模块的相关配置

	#PoE chip init 初始化POE供电
	boot_load_sync   platform_poe.sh

	#ALG modules load
	boot_load_sync   alg.sh

	# hide apmodel
	boot_load_sync   utils/hide_apmodel.sh

	# Load crash dump kernel
	boot_load_sync   utils/crash_dump.sh

	#提前生成vpn接口的cache,否则后续有用到相应的接口取值时会出错
	interface_get_name_to_cache_lan
	interface_get_name_to_cache_wan
	interface_get_name_to_cache_vlan
	interface_get_name_to_cache_pptp
	interface_get_name_to_cache_l2tp
	interface_get_name_to_cache_ovpn

	#mount raid and partition
	boot_load_sync   plugins.sh
	boot_load_sync   raid_mgmt.sh
	boot_load_sync   disk_mgmt.sh

	lcd_init
	clean_temp_webuser
	sanitize_config_db_ifs
	#联网更新前加载与绑定节点匹配的内置服务器地址
	$IK_DIR_SCRIPT/utils/update_hosts.sh init >/dev/null 2>&1
	start_ikuai_services
	start_remote_services

	[ -x /etc/oemrc ] && /etc/oemrc boot_begin >/dev/null 2>&1
	[ "$DEVELOPER" ] && /etc/mnt/deve.sh boot_begin >/dev/null 2>&1

	#Function
	boot_load_async  webuser.sh
	boot_load_sync   utils/led.sh
	boot_load_sync   utils/rps.sh
	boot_load_sync   basic.sh
	boot_load_sync   remote_control.sh
	boot_load_sync   lan.sh
	boot_load_sync   wan.sh
	boot_load_sync   lan.sh check_lan1
	boot_load_sync   vlan.sh
	boot_load_sync   iptv.sh
	boot_load_sync   ipv6.sh
	boot_load_sync   factory.sh

	boot_load_sync   openvpn-server.sh
	boot_load_async  register.sh
	boot_load_sync   notice_temp.sh
	boot_load_sync   notice_cycle.sh
	boot_load_sync   notice_remind.sh
	boot_load_sync   notice_expires.sh
	boot_load_sync   dprotos.sh
	boot_load_sync   dprotos_l7.sh
	boot_load_sync   static_rt.sh
	boot_load_sync   dhcp_acl_mac.sh
	boot_load_sync   dhcp6_acl_mac.sh
	boot_load_async  dhcp_server.sh
	boot_load_sync   custom_isp.sh
	boot_load_sync   ipgroup.sh
	boot_load_sync   ipv6group.sh
	boot_load_sync   macgroup.sh
	boot_load_sync   dtgroup.sh
	boot_load_async  lb_pcc.sh
	boot_load_sync   alone_limit.sh
	boot_load_async  stream_ipport.sh
	boot_load_async  stream_layer7.sh
	boot_load_async  stream_domain.sh
	boot_load_async  stream_updown.sh
	boot_load_async  ik_sysctl.sh

	boot_load_sync   dnat.sh
	boot_load_sync   nat_rule.sh
	boot_load_async  ddns.sh
	boot_load_async  netmap.sh
	boot_load_async  dns.sh
	boot_load_async  dns_replace.sh

	boot_load_sync   pppuser.sh
	boot_load_sync   ppp_passwd.sh
	boot_load_sync   ppp_paylog.sh
	boot_load_async  pptp_server.sh
	boot_load_async  l2tp_server.sh
	boot_load_async  pppoe_server.sh
	boot_load_sync   url_redirect.sh
	boot_load_sync   url_keywords.sh
	boot_load_sync   url_replace.sh
	boot_load_sync   mac_comment.sh
	boot_load_sync   wecom.sh
	boot_load_sync   dingtalk.sh
	boot_load_sync   ac_randkey.sh
	boot_load_async  ac_group.sh
	if [ "$SUPPORT_APMODE" ];then
		boot_load_sync  ac_server.sh
	else
		boot_load_async  ac_server.sh
	fi
	#boot_load_sync   ac_wechat_auth.sh

	#wifi 加载要在 一些关联业务的后面,避免开机重复加载多次wifi
	#另外GX2600多次启动可能会有一些异常问题
	boot_load_async  wifi.sh

	boot_load_async  ipsec-vpn.sh
	boot_load_async  pptp_client.sh
	boot_load_async  l2tp_client.sh
	boot_load_async  wireguard.sh
	#防火墙策略加载
	boot_load_sync   arp.sh
	boot_load_sync   acl.sh
	boot_load_sync   advanced.sh
	boot_load_sync   conn_limit.sh
	
	boot_load_async  upnpd.sh
	boot_load_async  netsnmp.sh
	boot_load_async  netsnmpc.sh
	boot_load_async  smbd.sh

	boot_load_sync  audit.sh
	boot_load_sync  acl_mac.sh
	boot_load_sync  url_black.sh
	boot_load_sync  acl_l7.sh
	boot_load_sync  mac_app.sh
	boot_load_sync  acl_l2route.sh
	boot_load_sync  acl_qq.sh
	boot_load_sync  domain_blacklist.sh
	boot_load_sync  audit_white.sh
	boot_load_sync  port_mirror.sh
	boot_load_sync  watchdog.sh
	
	boot_load_sync  simple_qos.sh
	boot_load_sync  mac_qos.sh
	boot_load_sync  ik_http_lua.sh
	boot_load_sync  webauth.sh
	if [ "$OEMNAME" = "wuying" ]; then
		boot_load_async wuying.sh
	fi

	boot_load_async  iksyscheck.sh
	boot_load_async  speedtest.sh
	boot_load_async  cflow.sh
	boot_load_async  wakeup.sh
	boot_load_async  reboots.sh
	boot_load_async  nginx_service.sh
	boot_load_async  openvpn-client.sh
	boot_load_async  js_inform3.sh
	boot_load_async  cloud_bak.sh
	boot_load_async  ikaudit.sh
	#boot_load_async  catcherd.sh
	boot_load_async  qemu.sh
	boot_load_async  dev_control.sh
	boot_load_async  key_manager.sh
	boot_load_async  ftp_server.sh
	boot_load_async  http_server.sh
	boot_load_async  igmp_proxy.sh
	boot_load_async  udp_proxy.sh
	boot_load_async  monitor_iface.sh
	boot_load_async  monitor_lanip.sh
	boot_load_async  iperf.sh
	boot_load_async  mtk_ax3000_e2p.sh

	boot_load_async  utils/submit.lua
	boot_load_async  utils/async.lua
	boot_load_async  utils/appid_load.lua
	boot_load_async  utils/update_hosts.sh
	boot_load_async  utils/urlfilter_load.sh
	boot_load_async  utils/collection.sh
	boot_load_async  utils/monitor_link.sh
	boot_load_async  utils/monitor_process.sh
	if [ -z "$OEMNAME" -o "$OEMNAME" = "oem" ]; then
		boot_load_async  utils/get_hosts.sh
	fi
	boot_load_async  utils/ik_warning.sh
	boot_load_async  vrrp_config.sh
	boot_load_async  cloud_switch.sh
	boot_load_async  irqbalance.sh
	boot_load_async  utils/ik_warn_rt.sh
	boot_load_async  stream_control.sh #开机加载流控策略需要靠后点,因为前面有些数据没初始化完,可能加载会失败.
	boot_load_async  utils/crond.sh    #这个要用于放在最后面

	if [ "$MODELTYPE" = "C3000" ]; then
		boot_load_async  utils/monitor_sim_link.sh
	fi

	#=======================================结束IKUAI脚本============================================
	$IK_DIR_SCRIPT/feature_port.sh boot >/tmp/iktmp/feature_port.log 2>&1 &
	[ -x /etc/oemrc ] && /etc/oemrc boot_end >/dev/null 2>&1 &
	[ "$DEVELOPER" ] && /etc/mnt/deve.sh boot_end >/dev/null 2>&1
	put_ikapps_into_cgroups
	Syslog $(Iecho i18n_rc_sys_starting)

	# In order to save mem, delete all kernel modules on non-x86
	delete_kernel_modules
	drop_caches
}

stop_ikuai_webradius()
{
	if [ ! -e "/tmp/iktmp/ik_web_radius.status" ]; then
		return
	fi
	killall -q ik_web_radius
	for i in 1 2 3; do
		sleep 2
		killall -q ik_web_radius || break
	done
}

stop()
{
	[ "$CURRENT_APMODE" ] && exit 0
	[ "$BOOTGUIDE" = "cd" -o "$BOOTGUIDE" = "ucd" ] && exit 0
	Syslog $(Iecho i18n_rc_sys_shutdown)
	stop_ikuai_services
	stop_ikuai_webradius
	killall -q hotplug2
	killall -q monitor
	killall -q openresty
	killall -q ik_rest
	killall -q crond
	killall -q dropbear

	if [ "$ARCH" = "mips" -o "$SUPPORT_RTC" = "0" ];then
		date +"%F %T" > $IK_DIR_DATA/datetimesync
	fi

	$IK_DIR_SCRIPT/dhcp_server.sh backup_leases_file
	$IK_DIR_SCRIPT/webauth.sh backup_webauth
	$IK_DIR_SCRIPT/qemu.sh shutdown >/dev/null 2>&1

	sync
	sleep 5

	killall -q iksyslogd
	return 0
}

load_sysctl()
{
	local total_mem=$(free | awk 'NR==2{printf "%.f",$2/1024.0}')

	if [ "$ARCH" = "x86" -o "$ARCH" = "arm" ];then
		echo net.ipv4.neigh.default.gc_thresh1=16384 >>/etc/sysctl.conf 
		echo net.ipv4.neigh.default.gc_thresh2=16384 >>/etc/sysctl.conf 
		echo net.ipv4.neigh.default.gc_thresh3=32768 >>/etc/sysctl.conf 
	fi

	if [ "$ARCH" != "x86" ];then
		if [ "$total_mem" -le 128 ];then
			nf_conntrack_max=16384
		elif [ "$total_mem" -le 256 ];then
			nf_conntrack_max=32768
		elif [ "$total_mem" -le 512 ];then
			nf_conntrack_max=65536
		fi

		if [ "$nf_conntrack_max" ];then
			sed -i "s/net.netfilter.nf_conntrack_max=.*/net.netfilter.nf_conntrack_max=$nf_conntrack_max/" /etc/sysctl.conf 
		fi
	fi

	if [ "$total_mem" -le 100 ];then
		max_dgram_qlen=64
	elif [ "$total_mem" -le 200 ];then
		max_dgram_qlen=128
	elif [ "$total_mem" -le 400 ];then
		max_dgram_qlen=256
	elif [ "$total_mem" -le 800 ];then
		max_dgram_qlen=512
	elif [ "$total_mem" -le 1800 ];then
		max_dgram_qlen=1024
	else
		max_dgram_qlen=2048
	fi

	local nf_conntrack_expect_max=$(cat /proc/sys/net/netfilter/nf_conntrack_expect_max)
	if [ "$nf_conntrack_expect_max" -lt 1024 ];then
		echo net.netfilter.nf_conntrack_expect_max=1024 >>/etc/sysctl.conf 
	fi

	echo net.unix.max_dgram_qlen=$max_dgram_qlen >>/etc/sysctl.conf 

	sysctl -p >/dev/null 2>/dev/null
# least-privilege kernel controls; root routing operations remain permitted.
[ ! -w /proc/sys/kernel/unprivileged_bpf_disabled ] || echo 1 > /proc/sys/kernel/unprivileged_bpf_disabled
[ ! -w /proc/sys/kernel/kptr_restrict ] || echo 1 > /proc/sys/kernel/kptr_restrict
[ ! -w /proc/sys/kernel/dmesg_restrict ] || echo 1 > /proc/sys/kernel/dmesg_restrict


	mkdir -p /tmp/coredump
	echo /tmp/coredump/%e >/proc/sys/kernel/core_pattern

	local disable_ipv6=$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6)
	if [ "$disable_ipv6" != "0" ];then
		sysctl -w -q net.ipv6.conf.all.disable_ipv6=0
		sysctl -w -q net.ipv6.conf.default.forwarding=1
		sysctl -w -q net.ipv6.conf.all.forwarding=1
	fi
	
}

autoconfig_by_udisk()
{
	local id=$(sqlite3 $IK_DB_CONFIG  "select 1 from webuser where id=1 and username='admin' and passwd='21232f297a57a5a743894a0e4a801fc3'")
	if [ "$id" = "1" ];then
		touch /tmp/iktmp/is_default_webuser

		if [ -e $IK_DIR_CONF/reset_default.ip ];then
			ip addr add 192.168.1.1/32 scope host dev lo
		fi

		blkid -t TYPE=vfat -s TYPE -o device | \
		while read dev ;do
			devname=${dev:5}
			devparent=${devname:0:3}
			DEVPATH=$(readlink /sys/block/$devparent)

			if [[ "$DEVPATH" =~ usb ]];then
				if mount -t vfat $dev /mnt ;then
					if [ -f "/mnt/AutoConfig.txt" ];then
						cp /mnt/AutoConfig.txt /tmp/iktmp/AutoConfig.txt
						/usr/ikuai/script/utils/autoconfig.sh /tmp/iktmp/AutoConfig.txt
					fi

					umount /mnt
					[ -f /tmp/iktmp/AutoConfig.txt ]&& break
				fi
			fi
		done
	fi
}

restore_factory_default() {
	if [ -e $IK_DIR_CONF/reset_default.flag ];then
		rm -f $IK_DIR_CONF/reset_default.flag
		$IK_DIR_SCRIPT/lan.sh reset_default
		$IK_DIR_SCRIPT/wan.sh reset_default
		$IK_DIR_SCRIPT/wifi.sh reset_default
		$IK_DIR_SCRIPT/dhcp_server.sh reset_default
	else
		$IK_DIR_SCRIPT/lan.sh check_config
		$IK_DIR_SCRIPT/dhcp_server.sh check_config
	fi
}


