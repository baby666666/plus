create_ipset_default()
{
	ipset -N Linux_lan_default hash:net			#内网IP组
	ipset -N Linux_wan_default hash:net			#外网IP组
	ipset -N Linux_alone_intell hash:ip			#独立限速

	ipset -N Linux_webauth_default hash:net			#WEB认证IP组
	ipset -N Linux_webauth_white hash:net			#WEB认证白名单目的IP
	ipset -N Linux_webauth_white_https hash:ip --timeout 7200 #WEB认证,HTTPS重定向白名单
	ipset -N Linux_webauth_wifi_enc	hash:mac		#通过AP加密免认证连接上来的mac
	ipset -N Linux_webauth_authed	hash:mac		#已认证的mac列表
	ipset -N Linux_webauth_white_mac hash:mac		#mac白名单列表
	ipset -N Linux_webauth_authed_list setlist --size 32 2>/dev/null
	ipset -! -A Linux_webauth_authed_list Linux_webauth_authed 2>/dev/null
	ipset -! -A Linux_webauth_authed_list Linux_webauth_wifi_enc 2>/dev/null
	ipset -! -A Linux_webauth_authed_list Linux_webauth_white_mac 2>/dev/null
}

create_iptables_chain()
{
	ipt_raw_prerouting	#初始化raw prerouting 规则链
	ipt_mangle_forward	#初始化mangle forward 规则链
	ipt_mangle_prerouting	#初始化mangle prerouting 规则链
	ipt_mangle_other
	ipt_filter_forward	#初始化filter forward 规则链
	ipt_nat_prerouting	#初始化nat prerouting 规则链
	ipt_nat_postrouting	#初始化nat postrouting 规则链(自动NAT上网)
	ipt_drop_wan_port	#阻断一些外网端口访问
	ipt_filter_other
}

ipt_drop_wan_port()
{
	ipset -N DROP_T_PORTS_WAN_IN bitmap:port range 1-65535
	ipset -N DROP_U_PORTS_WAN_IN bitmap:port range 1-65535
	iptables -w -I INPUT -p tcp -m set --match-set DROP_T_PORTS_WAN_IN dst -m ifaces --ifaces wan*,vwan*,adsl* --dir in -j DROP
	iptables -w -I INPUT -p udp -m set --match-set DROP_U_PORTS_WAN_IN dst -m ifaces --ifaces wan*,vwan*,adsl* --dir in -j DROP
	ip6tables -w -I INPUT -p tcp -m set --match-set DROP_T_PORTS_WAN_IN dst -m ifaces --ifaces wan*,vwan*,adsl* --dir in -j DROP
	ip6tables -w -I INPUT -p udp -m set --match-set DROP_U_PORTS_WAN_IN dst -m ifaces --ifaces wan*,vwan*,adsl* --dir in -j DROP
	while read proto ports ;do
		local setname=""
		if [ "$proto" = "tcp" ];then
			setname="DROP_T_PORTS_WAN_IN"
		elif [ "$proto" = "udp" ];then
			setname="DROP_U_PORTS_WAN_IN"
		fi
		for port in ${ports//,/ } ;do
			ipset -A $setname $port
		done
	done < /etc/defaults/drop_wan_port
}


ipt_filter_other()
{
	iptables -w -N INPUT_ACL
	ip6tables -w -N INPUT_ACL6
	iptables -w -N WEBACL
	iptables -w -N VNCACL
	iptables -w -N DHCP_ACL
	ip6tables -w -N DHCP6_ACL

	iptables -w -A INPUT -j INPUT_ACL
	ip6tables -w -A INPUT -j INPUT_ACL6
	iptables -w -A INPUT -j WEBACL
	iptables -w -A INPUT -j VNCACL
	iptables -w -A INPUT -p udp -m udp  --dport 67 -j DHCP_ACL
	ip6tables -w -A INPUT -p udp -m udp  --dport 547 -j DHCP6_ACL
}

ipt_nat_postrouting()
{
	iptables -w -t nat -N SRCNAT
	iptables -w -t nat -N NATRULE_SNAT
	iptables -w -t nat -N AUTONAT
	iptables -w -t nat -N MINIUPNPD-POSTROUTING
	iptables -w -t nat -N POST_FULLCONE
	iptables -w -t nat -A POSTROUTING ! -d 127.0.0.1 -j SRCNAT      #NAT转发规则
	iptables -w -t nat -A POSTROUTING ! -d 127.0.0.1 -j NATRULE_SNAT      #NAT规则snat方式
	iptables -w -t nat -A POSTROUTING ! -d 127.0.0.1 -j MINIUPNPD-POSTROUTING      #MINIUPNP自动转换端口
	iptables -w -t nat -A POSTROUTING ! -d 127.0.0.1 -j POST_FULLCONE     #full cone NAT
	iptables -w -t nat -A POSTROUTING ! -d 127.0.0.1 -j AUTONAT     #系统自动NAT

	ip6tables -w -t nat -A POSTROUTING -s fc00::/7 -d 2000::/3 -j MASQUERADE  # IPv6私网地址NAT
}
ipt_nat_prerouting()
{
	iptables -w -t nat -N DNSIKUAI8
	iptables -w -t nat -N DNSIKUAI8_NOAUTH
	iptables -w -t nat -N HTTPPROXY
	iptables -w -t nat -N HTTPSPROXY
	iptables -w -t nat -N MINIUPNPD
	iptables -w -t nat -N DSTNAT
	iptables -w -t nat -N NATRULE_DNAT
	iptables -w -t nat -N NETNAT
	iptables -w -t nat -N NOTICE
	iptables -w -t nat -N DNSPROXY
	iptables -w -t nat -N PRE_FULLCONE

	iptables -w -t nat -A PREROUTING -p udp --dport 53 $IPT_CONNTRACK_NEW $IPT_LAN_IFACE_IN -j DNSIKUAI8 
	iptables -w -t nat -A PREROUTING -p tcp -m multiport --dports 80,443 $IPT_CONNTRACK_NEW $IPT_LAN_IFACE_IN -j HTTPPROXY    #80端口代理
	iptables -w -t nat -A PREROUTING -p tcp -m multiport --dports 80,443 $IPT_CONNTRACK_NEW $IPT_LAN_IFACE_IN -j NOTICE	#WEB推送通知
	iptables -w -t nat -A PREROUTING $IPT_CONNTRACK_NEW $IPT_LOCAL_DST -j DSTNAT	    #端口映射
	iptables -w -t nat -A PREROUTING $IPT_CONNTRACK_NEW -j NATRULE_DNAT	    	#NAT规则dnat方式
	iptables -w -t nat -A PREROUTING $IPT_CONNTRACK_NEW $IPT_LOCAL_DST -j MINIUPNPD    #UPNPD
	iptables -w -t nat -A PREROUTING -p udp $IPT_WAN_IFACE_IN -j PRE_FULLCONE
	iptables -w -t nat -A PREROUTING $IPT_CONNTRACK_NEW $IPT_LOCAL_DST -j NETNAT       #1对1映射
	iptables -w -t nat -A PREROUTING -p udp --dport 53 $IPT_CONNTRACK_NEW $IPT_LAN_IFACE_IN -j DNSPROXY     #DNS代理
}
ipt_filter_forward()
{
	iptables -w -N AUTH_EXPIRES
	iptables -w -N ACL_MAC
	ip6tables -w -N ACL_MAC6
	iptables -w -N WECOM_BLOCK_MAC
	iptables -w -N LAYER7
	iptables -w -N QOS
	iptables -w -N SIMPLE
	iptables -w -N IP_QOS
	iptables -w -N MAC_QOS
	ip6tables -w -N MAC_QOS
	iptables -w -N FIREWALL
	ip6tables -w -N FIREWALL6
	iptables -w -N MINIUPNPD
	iptables -w -N ARP
	iptables -w -N PPPOE
	iptables -w -N WEBAUTH_QOS
	iptables -w -N L2TP_QOS
	iptables -w -N OVPN_QOS
	iptables -w -N PPPOE_QOS
	iptables -w -N PPTP_QOS
	iptables -w -N IKE_QOS
	iptables -w -N WEBAUTH
	iptables -w -N COUPON_QOS
	iptables -w -N LAN_VISIT
	iptables -w -N NONAT
	iptables -w -N PPP
	iptables -w -N CONNLIMIT

	iptables -w -A FORWARD $IPT_PPP_IFACE_IN -j AUTH_EXPIRES
	iptables -w -A FORWARD -j ACL_MAC
	ip6tables -w -A FORWARD -j ACL_MAC6
	iptables -w -A FORWARD -j WECOM_BLOCK_MAC
	iptables -w -A FORWARD -j CONNLIMIT
	iptables -w -A FORWARD -j LAYER7
	iptables -w -A FORWARD -j QOS
	iptables -w -A FORWARD -j SIMPLE
	iptables -w -A FORWARD -j IP_QOS
	iptables -w -A FORWARD -j MAC_QOS
	ip6tables -w -A FORWARD -j MAC_QOS
	iptables -w -A FORWARD -j COUPON_QOS
	iptables -w -A FORWARD -j WEBAUTH_QOS
	iptables -w -A FORWARD -j OVPN_QOS
	iptables -w -A FORWARD -j L2TP_QOS
	iptables -w -A FORWARD -j PPTP_QOS
	iptables -w -A FORWARD -j PPPOE_QOS
	iptables -w -A FORWARD -j IKE_QOS
	iptables -w -A FORWARD -j FIREWALL
	ip6tables -w -A FORWARD -j FIREWALL6
	iptables -w -A FORWARD -j LAN_VISIT
	iptables -w -A FORWARD -j NONAT
	iptables -w -A FORWARD $IPT_NOT_PPP_IFACE_IN -j WEBAUTH
	iptables -w -A FORWARD $IPT_LAN_IFACE_IN -j PPPOE
	iptables -w -A FORWARD $IPT_PPP_IFACE_IN $IPT_NOT_LAN_IFACE_OUT -j PPP
	iptables -w -A FORWARD $IPT_LAN_NOT_PPP_IN $IPT_WAN_IFACE_OUT -j ARP

	# ------------------------------------------------
	# IPv6 security rules
	#ip6tables -A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
	#ip6tables -A OUTPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
	#ip6tables -A FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
	#
	ip6tables -N WEBACL
	ip6tables -N input_reject
	ip6tables -A INPUT -j WEBACL
	#ip6tables -A input_reject -p udp --dport 546 -j RETURN
	#ip6tables -A input_reject -p tcp -j REJECT
	#ip6tables -A input_reject -p udp -j REJECT
	#
	#ip6tables -A forword_reject -p tcp -j REJECT
	#ip6tables -A forword_reject -p udp -j REJECT
	#
	#ip6tables -A INPUT -i wan+ -j input_reject
	#ip6tables -A INPUT -i adsl+ -j input_reject
	#ip6tables -A FORWARD -i wan+ -j forword_reject
	ip6tables -N forword_reject
	ip6tables -A FORWARD $IPT_WAN_IFACE_IN -j forword_reject

	ip6tables -w -N ROUTE_LOOP
	ip6tables -w -A FORWARD $IPT_WAN_IFACE_IN -j ROUTE_LOOP
}

ipt_raw_prerouting()
{
	iptables -w -t raw -N CONNLIMIT
	iptables -w -t raw -A PREROUTING -j CONNLIMIT
}

ipt_mangle_other()
{
	iptables -w -t mangle -N WEBCACHE_UP
	iptables -w -t mangle -N WEBCACHE_DOWN
	iptables -w -t mangle -N IPSEC_ROUTE
	iptables -w -t mangle -A OUTPUT -m conntrack --ctstate NEW -j IPSEC_ROUTE
	iptables -w -t mangle -A OUTPUT -j WEBCACHE_UP
	iptables -w -t mangle -A INPUT -j  WEBCACHE_DOWN
}

ipt_mangle_forward()
{
	iptables -w -t mangle -N LAYER7_IN
	iptables -w -t mangle -N LAYER7_OUT
	iptables -w -t mangle -N FASTOFFLOAD

	iptables -w -t mangle -N PPTPMSS
	iptables -w -t mangle -A FORWARD -p tcp+udp -j FASTOFFLOAD
	iptables -w -t mangle -A FORWARD -p tcp --tcp-flags SYN,RST SYN -j PPTPMSS #PPTP MSS报文长度修改

	# Todo: Need it ? IPv6 MSS fix
	# ip6tables -w -t mangle -A FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
}

ipt_mangle_prerouting()
{
	iptables -w -t mangle -N STREAM_LAYER7_NEW
	iptables -w -t mangle -N STREAM_IPPORT_NEW
	iptables -w -t mangle -N DPROTO

	iptables -w -t mangle -A PREROUTING $IPT_LAN_IFACE_IN -j DPROTO					 #自定义协议 标记appmark, 放在协议分流前面
	iptables -w -t mangle -A PREROUTING $IPT_LAN_IFACE_IN $IPT_NOT_LAN_DST $IPT_NOT_LOCAL_DST $IPT_LAN_SRC_CAN_ROUTE $IPT_NOT_WAN_DST -j STREAM_LAYER7_NEW	     #协议分流
	iptables -w -t mangle -A PREROUTING $IPT_CONNTRACK_NEW $IPT_LAN_IFACE_IN $IPT_NOT_LAN_DST $IPT_NOT_LOCAL_DST $IPT_LAN_SRC_CAN_ROUTE $IPT_NOT_WAN_DST -j STREAM_IPPORT_NEW	     #端口分流 标记connmark

	# WG decrypted original-direction connections use the same native port
	# policy chain; retain destination guards, without the LAN classifiers.
	iptables -w -t mangle -A PREROUTING -i wg+ -m mark --mark 0 $IPT_CONNTRACK_NEW \
		-m conntrack --ctdir ORIGINAL $IPT_NOT_LAN_DST $IPT_NOT_LOCAL_DST $IPT_NOT_WAN_DST \
		-j STREAM_IPPORT_NEW

	ip6tables -w -t mangle -N STREAM_IPV6_NEW
	ip6tables -w -t mangle -A PREROUTING $IPT_CONNTRACK_NEW $IPT_LAN_IFACE_IN $IPT_NOT_LOCAL_DST -j STREAM_IPV6_NEW
}

put_ikapps_into_cgroups()
{
	[ ! -e /proc/cgroups ]&& return 0
	ps |awk -v mem_path="/sys/fs/cgroup/memory/ik_apps/tasks" -v cpu_path="/sys/fs/cgroup/cpu/ik_apps/tasks" -v cpu_path_ua="/sys/fs/cgroup/cpu/ik_apps/ik_ua_parser/tasks"\
	'$5~/^ik_/{
		if($5=="ik_ua_parser"){
			cmds=sprintf("echo %s >> %s;%s",$1,cpu_path_ua,cmds)
			cmds=sprintf("echo %s >> %s;%s",$1,mem_path,cmds)
		}else{
			cmds=sprintf("echo %s >> %s;%s",$1,cpu_path,cmds)
			cmds=sprintf("echo %s >> %s;%s",$1,mem_path,cmds)
		}
	} END {
			system(cmds)
	}'
}

delete_kernel_modules()
{
	local exclude_ko="nf_conntrack_ftp.ko\nnf_conntrack_h323.ko\nnf_conntrack_sip.ko\nnf_conntrack_tftp.ko\nnf_nat_h323.ko\nnf_nat_ftp.ko\nnf_nat_sip.ko\nnf_nat_tftp.ko\nusbserial.ko\nusb_wwan.ko\noption.ko"
	if [ ${ARCH} = "mips" ]; then
		for mod_file in $(ls /lib/modules/$LINUX_VERSION/); do
			echo -e "$exclude_ko" | grep -q $mod_file || rm -rf /lib/modules/$LINUX_VERSION/$mod_file
		done		
	fi
}

#根据内存大小来设定nginx 工作线程数量
openresty_config_init()
{
	local mem100m=100000
	local mem200m=200000
	local mem500m=500000
	local mem1000m=1000000
	local mem2000m=2000000
	local mem3000m=3000000
	local mem4000m=4000000
	local mem8000m=8000000
	local mem16000m=16000000

	local worker_rlimit_nofile worker_connections
	local total_mem=$(awk '{print $2;exit}' /proc/meminfo)

	if [ "$total_mem" -ge $mem8000m ];then
		local nginx_worker_num=16
	elif [ "$total_mem" -ge $mem4000m ];then
		local nginx_worker_num=8
	elif [ "$total_mem" -ge $mem2000m ];then
		local nginx_worker_num=6
	elif [ "$total_mem" -ge $mem500m ];then
		local nginx_worker_num=4
	elif [ "$total_mem" -ge $mem200m ];then
		local nginx_worker_num=2
	else
		local nginx_worker_num=1

		worker_rlimit_nofile="s/worker_rlimit_nofile .*/worker_rlimit_nofile 1024;/;"
		worker_connections="s/worker_connections .*/worker_connections 1024;/;"

		echo 3 > /proc/sys/vm/drop_caches
	fi

	sed -i "s/^worker_processes.*/worker_processes $nginx_worker_num;/;$worker_rlimit_nofile $worker_connections" /usr/openresty/nginx.conf
}

mips_port_init()
{
	if [ -x $IK_DIR_SCRIPT/utils/ikswconfig.sh ];then
		$IK_DIR_SCRIPT/utils/ikswconfig.sh
	fi
}

portal_crt_link_oem()
{
	if [ "$PORTAL" = "portal.topspeedwifi.com" ];then
		ln -sf /usr/libproto/crts/portal_oem.crt /usr/openresty/ssl/portal.crt
		ln -sf /usr/libproto/crts/portal_oem.key /usr/openresty/ssl/portal.key
	fi
}

drop_caches()
{
	(sleep 30 ;echo 3 > /proc/sys/vm/drop_caches) >/dev/null 2>&1 &
}
